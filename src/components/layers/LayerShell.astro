---
import EdgeLayer from './EdgeLayer.astro';
import LayerField, { type LayerSection } from './LayerField.astro';
import { sectionLabels } from '../../data/i18n';

export type ActiveLayer = 'home' | LayerSection | 'article';

interface Props {
  active: ActiveLayer;
  breadcrumb: string;
  breadcrumbZh?: string;
  breadcrumbEn?: string;
  mobileBreadcrumb?: string;
  mobileBreadcrumbZh?: string;
  mobileBreadcrumbEn?: string;
  class?: string;
  flow?: boolean;
}

const {
  active,
  breadcrumb,
  breadcrumbZh = breadcrumb,
  breadcrumbEn = breadcrumb,
  mobileBreadcrumb = breadcrumb,
  mobileBreadcrumbZh = mobileBreadcrumb,
  mobileBreadcrumbEn = mobileBreadcrumb,
  class: className,
  flow = false,
} = Astro.props;
const sections: Array<{ id: LayerSection; href: string }> = [
  { id: 'projects', href: '/projects/' },
  { id: 'daily', href: '/daily/' },
  { id: 'archive', href: '/archive/' },
  { id: 'about', href: '/about/' },
];
const edgeSections =
  active === 'article'
    ? sections.filter((section) => section.id === 'archive')
    : active === 'home'
      ? []
      : sections.filter((section) => section.id !== active);
---

<div
  class:list={['layer-shell', `layer-shell--${active}`, flow && 'layer-shell--flow', className]}
  data-layer-root
  data-active-layer={active}
>
  <p class="layer-breadcrumb">
    <span
      class="layer-breadcrumb__desktop"
      data-i18n-zh={breadcrumbZh}
      data-i18n-en={breadcrumbEn}
    >{breadcrumbZh}</span>
    <span
      class="layer-breadcrumb__mobile"
      data-i18n-zh={mobileBreadcrumbZh}
      data-i18n-en={mobileBreadcrumbEn}
    >{mobileBreadcrumbZh}</span>
  </p>
  <div class="layer-shell__stage">
    {edgeSections.map((section) => (
      <EdgeLayer
        section={section.id}
        href={section.href}
        labelZh={sectionLabels[section.id].zh}
        labelEn={sectionLabels[section.id].en}
      />
    ))}

    {active === 'home' ? (
      <slot />
    ) : active === 'article' ? (
      <article class="article-sheet">
        <div class="article-sheet__content">
          <slot />
        </div>
      </article>
    ) : (
      <LayerField
        section={active as LayerSection}
        active
        labelZh={sectionLabels[active as LayerSection].zh}
        labelEn={sectionLabels[active as LayerSection].en}
        ariaLabelZh={`${sectionLabels[active as LayerSection].zh}区域`}
        ariaLabelEn={`${sectionLabels[active as LayerSection].en} section`}
      >
        <slot />
      </LayerField>
    )}
  </div>
</div>

<script src="../../scripts/layer-interactions.ts"></script>
