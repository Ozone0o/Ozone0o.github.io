---
import type { LayerSection } from './LayerField.astro';

interface Props {
  section: LayerSection;
  href: string;
  label?: string;
  labelZh?: string;
  labelEn?: string;
}

const { section, href, label = section.toUpperCase(), labelZh = label, labelEn = label } = Astro.props;
---

<aside class:list={['edge-layer', `edge-layer--${section}`]} data-edge-layer={section}>
  <a
    class="edge-layer__link"
    href={href}
    aria-label={`打开${labelZh}`}
    data-i18n-aria-zh={`打开${labelZh}`}
    data-i18n-aria-en={`Open ${labelEn}`}
    data-layer-link
  >
    <span class="edge-layer__label" data-i18n-zh={labelZh} data-i18n-en={labelEn}>{labelZh}</span>
  </a>
</aside>
