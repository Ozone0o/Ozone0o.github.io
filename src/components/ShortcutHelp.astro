<aside class="shortcut-help" data-shortcut-help aria-hidden="true" hidden>
  <div class="shortcut-help__paper" data-shortcut-paper>
    <button
      class="shortcut-help__close"
      type="button"
      data-shortcut-close
      aria-label="关闭快捷键帮助"
      data-i18n-aria-zh="关闭快捷键帮助"
      data-i18n-aria-en="Close shortcut help"
    >×</button>
    <p class="shortcut-help__eyebrow" data-i18n-zh="快捷键" data-i18n-en="SHORTCUT HELP">快捷键</p>
    <div class="shortcut-help__rows" aria-label="快捷键列表" data-i18n-aria-zh="快捷键列表" data-i18n-aria-en="Shortcut list">
      <div><kbd>H</kbd><span data-i18n-zh="首页" data-i18n-en="HOME">首页</span></div>
      <div><kbd>P</kbd><span data-i18n-zh="项目" data-i18n-en="PROJECTS">项目</span></div>
      <div><kbd>D</kbd><span data-i18n-zh="日常" data-i18n-en="DAILY">日常</span></div>
      <div><kbd>A</kbd><span data-i18n-zh="档案" data-i18n-en="ARCHIVE">档案</span></div>
      <div><kbd>M</kbd><span data-i18n-zh="音乐" data-i18n-en="RADIO">音乐</span></div>
      <div><kbd>R</kbd><span data-i18n-zh="随机" data-i18n-en="RANDOM">随机</span></div>
      <div><kbd>?</kbd><span data-i18n-zh="帮助" data-i18n-en="HELP">帮助</span></div>
    </div>
  </div>
</aside>
