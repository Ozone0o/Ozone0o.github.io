---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LayerShell from '../../components/layers/LayerShell.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="Projects"
  description="An editorial index of projects and project notes."
  activeSection="projects"
>
  <LayerShell
    active="projects"
    breadcrumb="项目"
    breadcrumbZh="项目"
    breadcrumbEn="PROJECTS"
    mobileBreadcrumb="项目"
    mobileBreadcrumbZh="项目"
    mobileBreadcrumbEn="PROJECTS"
  >
    <div class="sheet-content sheet-content--projects">
      <header class="section-sheet-header">
        <div>
          <h1 data-i18n-zh="项目" data-i18n-en="PROJECTS">项目</h1>
          <p
            class="section-sheet-header__summary"
            data-i18n-zh="做过、测试过、拆过、重建过，最后留下记录的东西。"
            data-i18n-en="Things built, tested, broken, rebuilt, and eventually documented."
          >做过、测试过、拆过、重建过，最后留下记录的东西。</p>
        </div>
        <p class="sheet-status">
          {projects.length}
          <span data-i18n-zh=" 个项目 / 公开仓库" data-i18n-en=" PROJECTS / PUBLIC REPOSITORIES"> 个项目 / 公开仓库</span>
        </p>
      </header>

      <div class="project-index" aria-label="项目索引" data-i18n-aria-zh="项目索引" data-i18n-aria-en="Project index">
        {projects.map((project, index) => (
          <a
            class="project-entry"
            href={`/projects/${project.slug}/`}
            aria-label={`打开${project.title}`}
            data-i18n-aria-zh={`打开${project.title}`}
            data-i18n-aria-en={`Open ${project.title}`}
          >
            <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="project-name">{project.title}</span>
            <span class="project-description" data-i18n-zh={project.shortDescription.zh} data-i18n-en={project.shortDescription.en}>{project.shortDescription.zh}</span>
            <span class="project-year">{project.year}</span>
            <span class="project-status" data-i18n-zh={project.status.zh} data-i18n-en={project.status.en}>{project.status.zh}</span>
            <span class="project-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </LayerShell>
</BaseLayout>
