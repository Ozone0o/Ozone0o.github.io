---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="The requested Ozone Layer route was not found.">
  <section class="not-found">
    <article class="not-found__paper">
      <p class="not-found__code">404</p>
      <h1 data-i18n-zh="你掉出了这一层。" data-i18n-en="YOU FELL THROUGH THE LAYER.">你掉出了这一层。</h1>
      <a class="not-found__link" href="/">
        <span data-i18n-zh="返回表面 →" data-i18n-en="RETURN TO SURFACE →">返回表面 →</span>
      </a>
    </article>
  </section>
</BaseLayout>
