---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LayerShell from '../../components/layers/LayerShell.astro';

const posts = (await getCollection('writing')).sort(
  (a: CollectionEntry<'writing'>, b: CollectionEntry<'writing'>) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---

<BaseLayout
  title="Writing"
  description="The complete Writing index for the Ozone Layer archive."
  activeSection="archive"
>
  <LayerShell
    active="archive"
    breadcrumb="随笔"
    breadcrumbZh="随笔 / 索引"
    breadcrumbEn="WRITING / INDEX"
    mobileBreadcrumb="随笔"
    mobileBreadcrumbZh="随笔"
    mobileBreadcrumbEn="WRITING"
  >
    <div class="sheet-content sheet-content--archive writing-index">
      <header class="section-sheet-header">
        <div>
          <h1 data-i18n-zh="随笔" data-i18n-en="WRITING">随笔</h1>
          <p
            class="section-sheet-header__summary"
            data-i18n-zh="档案中的一种内容，不是另一张顶层纸片。"
            data-i18n-en="A content type inside the archive, not another top-level layer."
          >档案中的一种内容，不是另一张顶层纸片。</p>
        </div>
        <p class="sheet-status">
          {posts.length}
          <span data-i18n-zh=" 篇 / 历史内容" data-i18n-en=" ENTRIES / LEGACY CONTENT"> 篇 / 历史内容</span>
        </p>
      </header>

      <div class="entry-list" aria-label="随笔条目" data-i18n-aria-zh="随笔条目" data-i18n-aria-en="Writing entries">
        {posts.map((post: CollectionEntry<'writing'>) => (
          <article class="entry-card">
            <p class="entry-meta">{formatDate(post.data.date)}</p>
            <div>
              <h2><a href={`/writing/${post.data.slug}/`}>{post.data.title}</a></h2>
              {post.data.description && <p>{post.data.description}</p>}
              <a class="text-link" href={`/writing/${post.data.slug}/`}>
                <span data-i18n-zh="打开条目" data-i18n-en="OPEN ENTRY">打开条目</span> →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </LayerShell>
</BaseLayout>
