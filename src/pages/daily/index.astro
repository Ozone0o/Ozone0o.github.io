---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const daily = (await getCollection('daily')).sort(
  (a: CollectionEntry<'daily'>, b: CollectionEntry<'daily'>) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const rendered = await Promise.all(
  daily.map(async (entry: CollectionEntry<'daily'>) => ({ entry, Content: (await render(entry)).Content })),
);
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const formatDateRange = (start: Date, end?: Date) => end ? `${formatDate(start)} → ${formatDate(end)}` : formatDate(start);
---

<BaseLayout title="Daily">
  <SectionHeading title="Daily" description={`${daily.length} migrated date groups.`} />
  <div class="daily-list">
    {rendered.map(({ entry, Content }) => (
      <section class="daily-entry">
        <header>
          <p class="entry-meta">{formatDateRange(entry.data.date, entry.data.endDate)} · {entry.data.itemCount} items</p>
          <h2>{entry.data.legacyDateLabel ?? formatDateRange(entry.data.date, entry.data.endDate)}</h2>
          {entry.data.dateResolution === 'range' && (
            <p class="entry-note">Explicit legacy date range preserved; items remain in source order.</p>
          )}
        </header>
        <div class="prose"><Content /></div>
      </section>
    ))}
  </div>
</BaseLayout>
