---
import '../styles/global.css';
import { ui } from '../data/i18n';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  activeSection?: string;
}

const {
  title,
  description = 'Ozone Layer — a public layer for things being made, noticed, remembered, and left unfinished.',
  canonical,
  activeSection = 'home',
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://ozoneo0.cn');
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteOrigin).href;
const pageTitle = title.toLowerCase() === 'ozone layer' ? 'Ozone Layer' : `${title} — Ozone Layer`;
const versionLabel = new Intl.DateTimeFormat('en-GB', {
  month: '2-digit',
  year: 'numeric',
  timeZone: 'Asia/Shanghai',
})
  .format(new Date())
  .replace('/', '.');
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-lang="zh">
  <head>
    <script is:inline>
      (() => {
        try {
          const root = document.documentElement;
          const storedTheme = localStorage.getItem('ozone-layer-theme');
          const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          const theme = storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : systemTheme;
          const language = localStorage.getItem('ozone-language') === 'en'
            ? 'en'
            : localStorage.getItem('ozone-layer-language') === 'en'
              ? 'en'
              : 'zh';
          root.dataset.theme = theme;
          root.dataset.lang = language;
          root.lang = language === 'en' ? 'en' : 'zh-CN';
        } catch {
          // The first paint remains usable when storage is unavailable.
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F2EFE7" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={activeSection === 'article' ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body data-active-section={activeSection}>
    <header class="site-header">
      <div class="site-header__inner">
        <div class="site-brand">
          <a
            class="site-title"
            href="/"
            aria-label="返回首页"
            data-i18n-aria-zh="返回首页"
            data-i18n-aria-en="Ozone Layer home"
          >OZONE LAYER</a>
          <span class="site-separator" aria-hidden="true">/</span>
          <span class="site-version">{versionLabel}</span>
        </div>

        <div
          class="site-controls"
          aria-label={ui.controls.site.zh}
          data-i18n-aria-zh={ui.controls.site.zh}
          data-i18n-aria-en={ui.controls.site.en}
        >
          <div
            class="control-group"
            aria-label={ui.controls.language.zh}
            data-i18n-aria-zh={ui.controls.language.zh}
            data-i18n-aria-en={ui.controls.language.en}
          >
            <button
              class="control-button language-control"
              type="button"
              data-language-option="zh"
              aria-pressed="true"
              aria-label={ui.controls.useChinese.zh}
              data-i18n-aria-zh={ui.controls.useChinese.zh}
              data-i18n-aria-en={ui.controls.useChinese.en}
            >ZH</button>
            <span class="control-group__separator" aria-hidden="true">/</span>
            <button
              class="control-button language-control"
              type="button"
              data-language-option="en"
              aria-pressed="false"
              aria-label={ui.controls.useEnglish.zh}
              data-i18n-aria-zh={ui.controls.useEnglish.zh}
              data-i18n-aria-en={ui.controls.useEnglish.en}
            >EN</button>
          </div>
          <div
            class="control-group"
            aria-label={ui.controls.theme.zh}
            data-i18n-aria-zh={ui.controls.theme.zh}
            data-i18n-aria-en={ui.controls.theme.en}
          >
            <button
              class="control-button theme-control"
              type="button"
              data-theme-option="light"
              aria-pressed="true"
              aria-label={ui.controls.useLight.zh}
              data-i18n-aria-zh={ui.controls.useLight.zh}
              data-i18n-aria-en={ui.controls.useLight.en}
              data-i18n-zh={ui.controls.light.zh}
              data-i18n-en={ui.controls.light.en}
            >浅色</button>
            <span class="control-group__separator" aria-hidden="true">/</span>
            <button
              class="control-button theme-control"
              type="button"
              data-theme-option="dark"
              aria-pressed="false"
              aria-label={ui.controls.useDark.zh}
              data-i18n-aria-zh={ui.controls.useDark.zh}
              data-i18n-aria-en={ui.controls.useDark.en}
              data-i18n-zh={ui.controls.dark.zh}
              data-i18n-en={ui.controls.dark.en}
            >深色</button>
          </div>
        </div>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        const themeMedia = window.matchMedia('(prefers-color-scheme: dark)');

        const setTheme = (theme, persist = true) => {
          root.dataset.theme = theme;
          if (persist) localStorage.setItem('ozone-layer-theme', theme);
          document.querySelectorAll('[data-theme-option]').forEach((button) => {
            button.setAttribute('aria-pressed', button.dataset.themeOption === theme ? 'true' : 'false');
          });
          if (themeMeta) themeMeta.setAttribute('content', theme === 'dark' ? '#171717' : '#F2EFE7');
        };

        const setLanguage = (language, persist = true) => {
          const nextLanguage = language === 'en' ? 'en' : 'zh';
          root.dataset.lang = nextLanguage;
          root.lang = nextLanguage === 'en' ? 'en' : 'zh-CN';
          if (persist) {
            localStorage.setItem('ozone-language', nextLanguage);
            // Keep the previous key readable for existing visitors.
            localStorage.setItem('ozone-layer-language', nextLanguage);
          }
          document.querySelectorAll('[data-language-option]').forEach((button) => {
            button.setAttribute('aria-pressed', button.dataset.languageOption === nextLanguage ? 'true' : 'false');
          });
          document.querySelectorAll('[data-i18n-zh][data-i18n-en]').forEach((element) => {
            const value = nextLanguage === 'en' ? element.dataset.i18nEn : element.dataset.i18nZh;
            if (value !== undefined) element.textContent = value;
          });
          document.querySelectorAll('[data-i18n-aria-zh][data-i18n-aria-en]').forEach((element) => {
            const value = nextLanguage === 'en' ? element.dataset.i18nAriaEn : element.dataset.i18nAriaZh;
            if (value !== undefined) element.setAttribute('aria-label', value);
          });
          document.querySelectorAll('[data-i18n-title-zh][data-i18n-title-en]').forEach((element) => {
            const value = nextLanguage === 'en' ? element.dataset.i18nTitleEn : element.dataset.i18nTitleZh;
            if (value !== undefined) element.setAttribute('title', value);
          });
          window.dispatchEvent(new CustomEvent('ozone:language-change', { detail: nextLanguage }));
        };

        document.querySelectorAll('[data-theme-option]').forEach((button) => {
          button.addEventListener('click', () => setTheme(button.dataset.themeOption));
        });
        document.querySelectorAll('[data-language-option]').forEach((button) => {
          button.addEventListener('click', () => setLanguage(button.dataset.languageOption));
        });

        try {
          const savedTheme = localStorage.getItem('ozone-layer-theme');
          const savedLanguage = localStorage.getItem('ozone-language') ?? localStorage.getItem('ozone-layer-language');
          setTheme(savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : (themeMedia.matches ? 'dark' : 'light'), false);
          setLanguage(savedLanguage === 'en' ? 'en' : 'zh', false);
          themeMedia.addEventListener('change', (event) => {
            if (!localStorage.getItem('ozone-layer-theme')) setTheme(event.matches ? 'dark' : 'light', false);
          });
        } catch {
          setTheme(root.dataset.theme === 'dark' ? 'dark' : 'light', false);
          setLanguage(root.dataset.lang === 'en' ? 'en' : 'zh', false);
        }
      })();
    </script>
  </body>
</html>
